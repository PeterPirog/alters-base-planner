{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/alters-base-planner/plan.schema.json",
  "title": "The Alters Base Planner configuration",
  "description": "Player input only. The player selects Base tier and room counts. Corridor and Elevator counts/placements are never player inputs; they are generated by the solver.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "base_tier": {
      "type": "integer",
      "enum": [1, 2, 3, 4],
      "description": "Base tier selected by the player."
    },
    "rooms": {
      "type": "object",
      "description": "Counts of player-selectable rooms only. Do not add corridor/elevator keys; the solver derives all required Corridors and Elevators.",
      "additionalProperties": false,
      "properties": {
        "ark_sarcophagus": {"$ref": "#/$defs/count"},
        "contemplation_room": {"$ref": "#/$defs/count"},
        "dormitory": {"$ref": "#/$defs/count"},
        "gamers_den": {"$ref": "#/$defs/count"},
        "greenhouse": {"$ref": "#/$defs/count"},
        "gym": {"$ref": "#/$defs/count"},
        "infirmary": {"$ref": "#/$defs/count"},
        "large_storage": {"$ref": "#/$defs/count"},
        "materializer": {"$ref": "#/$defs/count"},
        "medium_storage": {"$ref": "#/$defs/count"},
        "park_with_bench": {"$ref": "#/$defs/count"},
        "personal_cabin": {"$ref": "#/$defs/count"},
        "radiation_repulsor": {"$ref": "#/$defs/count"},
        "rapidium_ark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum five Rapidium Ark modules in the mobile-base model."
        },
        "recycler": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "The game permits at most one Recycler in the base."
        },
        "refinery": {"$ref": "#/$defs/count"},
        "research_lab": {"$ref": "#/$defs/count"},
        "small_storage": {"$ref": "#/$defs/count"},
        "social_room": {"$ref": "#/$defs/count"},
        "workshop": {"$ref": "#/$defs/count"}
      }
    },
    "usage_weights": {
      "type": "object",
      "description": "Optional per-plan SYSTEM/PLAYER traffic-weight overrides.",
      "additionalProperties": false,
      "properties": {
        "airlock": {"$ref": "#/$defs/usageWeight"},
        "ark_sarcophagus": {"$ref": "#/$defs/usageWeight"},
        "captains_cabin": {"$ref": "#/$defs/usageWeight"},
        "command_center": {"$ref": "#/$defs/usageWeight"},
        "communication_room": {"$ref": "#/$defs/usageWeight"},
        "contemplation_room": {"$ref": "#/$defs/usageWeight"},
        "dormitory": {"$ref": "#/$defs/usageWeight"},
        "gamers_den": {"$ref": "#/$defs/usageWeight"},
        "greenhouse": {"$ref": "#/$defs/usageWeight"},
        "gym": {"$ref": "#/$defs/usageWeight"},
        "infirmary": {"$ref": "#/$defs/usageWeight"},
        "kitchen": {"$ref": "#/$defs/usageWeight"},
        "large_storage": {"$ref": "#/$defs/usageWeight"},
        "machinery": {"$ref": "#/$defs/usageWeight"},
        "materializer": {"$ref": "#/$defs/usageWeight"},
        "medium_storage": {"$ref": "#/$defs/usageWeight"},
        "park_with_bench": {"$ref": "#/$defs/usageWeight"},
        "personal_cabin": {"$ref": "#/$defs/usageWeight"},
        "quantum_computer": {"$ref": "#/$defs/usageWeight"},
        "radiation_repulsor": {"$ref": "#/$defs/usageWeight"},
        "rapidium_ark": {"$ref": "#/$defs/usageWeight"},
        "recycler": {"$ref": "#/$defs/usageWeight"},
        "refinery": {"$ref": "#/$defs/usageWeight"},
        "research_lab": {"$ref": "#/$defs/usageWeight"},
        "small_storage": {"$ref": "#/$defs/usageWeight"},
        "social_room": {"$ref": "#/$defs/usageWeight"},
        "womb": {"$ref": "#/$defs/usageWeight"},
        "workshop": {"$ref": "#/$defs/usageWeight"}
      }
    },
    "solver": {
      "type": "object",
      "description": "Optimization controls only. Utility counts are not configurable here either.",
      "additionalProperties": false,
      "properties": {
        "objective": {"const": "weighted_pair_distance"},
        "time_limit_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Global wall-clock budget for the complete solve operation, in seconds. It is not reset for each room-packing attempt."
        },
        "max_layout_attempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of unique room packings examined. Pure label permutations of identical room instances are symmetry-broken."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "svg": {"type": "string", "minLength": 1},
        "png": {"type": "string", "minLength": 1},
        "json": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": ["base_tier", "rooms"],
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "usageWeight": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  }
}
